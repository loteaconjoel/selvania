# Copia este archivo como .env y rellena los valores.
# El .env real está en .gitignore: nunca se sube al repositorio.
#
# Para generar el hash y un secreto nuevos:
#   node scripts/hash-password.mjs
#
# Estas tres variables también hay que darlas de alta en Vercel, en
# Settings > Environment Variables del proyecto.

ADMIN_USER="adminS"

# Hash scrypt de la contraseña. La contraseña en claro no se guarda en ningún lado.
ADMIN_PASSWORD_HASH=""

# Clave con la que se firman las cookies de sesión. Al cambiarla se cierran
# todas las sesiones abiertas.
SESSION_SECRET=""
