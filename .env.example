# Copia este archivo como .env y rellena los valores.
# El .env real está en .gitignore: nunca se sube al repositorio.
#
# Todas estas variables hay que darlas de alta también en Vercel, en
# Settings > Environment Variables del proyecto.

# ---------------------------------------------------------------------------
# Acceso al panel
# ---------------------------------------------------------------------------
# Para generar el hash y un secreto nuevos:  node scripts/hash-password.mjs

ADMIN_USER="adminS"

# Hash scrypt de la contraseña. La contraseña en claro no se guarda en ningún lado.
ADMIN_PASSWORD_HASH=""

# Clave con la que se firman las cookies de sesión. Al cambiarla se cierran
# todas las sesiones abiertas.
SESSION_SECRET=""

# ---------------------------------------------------------------------------
# Almacenamiento del contenido y las imágenes (Supabase)
# ---------------------------------------------------------------------------
# Si estas dos faltan, el panel guarda en data/content.json y las imágenes en
# public/uploads. Eso sirve para trabajar en local, pero en Vercel el disco es
# de solo lectura y no se podrá guardar nada.
#
# Dónde encontrarlas: Supabase > tu proyecto > Settings > API
#   SUPABASE_URL              -> "Project URL"
#   SUPABASE_SERVICE_ROLE_KEY -> "service_role" (la secreta, NO la anon)
#
# La clave service_role salta las políticas de acceso, así que solo puede vivir
# en el servidor. Nunca la pongas en una variable que empiece por PUBLIC_.

SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
