---
import type { SiteContent } from '../data/types';

interface Props {
  footer: SiteContent['footer'];
  brand: string;
}

const { footer, brand } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="border-t border-sv-lime/15 bg-sv-jungle-deep px-4 py-12 sm:px-6">
  <div class="mx-auto max-w-6xl text-center">
    <p class="font-heading text-xl font-bold tracking-wide text-sv-lime uppercase">
      {brand}
    </p>
    <p class="mt-3 text-sm text-sv-cream/60">{footer.text}</p>

    {
      footer.links.length > 0 && (
        <nav class="mt-6 flex flex-wrap justify-center gap-x-6 gap-y-2">
          {footer.links.map((link) => (
            <a href={link.href} class="text-sm text-sv-cream/60 underline-offset-4 hover:text-sv-lime hover:underline">
              {link.label}
            </a>
          ))}
        </nav>
      )
    }

    <p class="mt-8 text-xs text-sv-cream/40">© {year} {brand}. Todos los derechos reservados.</p>
  </div>
</footer>
