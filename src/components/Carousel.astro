---
import CarouselShell from './CarouselShell.astro';
import type { Media } from '../data/types';
import type { Surface } from '../lib/surface';

interface Props {
  images: Media[];
  label: string;
  surface?: Surface;
}

const { images, label, surface = 'dark' } = Astro.props;

const tone = {
  dark: {
    // Sombra corta y muy difuminada hacia abajo. Una sombra grande y teñida
    // sobre un fondo plano deja un manchón alrededor de la foto en vez de
    // leerse como profundidad.
    frame: 'ring-1 ring-sv-lime/25 shadow-lg shadow-black/40',
    caption: 'text-sv-cream/70',
  },
  light: {
    frame: 'ring-1 ring-sv-jungle-deep/20 shadow-lg shadow-sv-jungle-deep/20',
    caption: 'text-sv-jungle-deep',
  },
}[surface];
---

<CarouselShell label={label} surface={surface} lightbox>
  {
    images.map((img) => (
      <figure class="min-w-0 shrink-0 grow-0 basis-[88%] pl-3 sm:basis-[56%] sm:pl-5 lg:basis-[42%]">
        {/* El escalado va en este envoltorio y no en el <figure>: si se aplica
            al figure, su relleno se encoge con él y la foto vecina se desplaza
            encima de la activa. */}
        <div data-slide class="transition-[transform,filter] duration-500">
          <div
            class:list={[
              'relative aspect-4/3 overflow-hidden rounded-3xl bg-sv-jungle-deep',
              tone.frame,
            ]}
          >
            <img
              src={img.src}
              alt={img.alt}
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover"
            />

            <button
              type="button"
              data-zoom
              data-src={img.src}
              data-alt={img.alt}
              data-caption={img.caption ?? ''}
              aria-label={`Ampliar imagen: ${img.alt}`}
              class="absolute top-3 right-3 grid h-10 w-10 place-items-center rounded-full bg-sv-jungle-deep/70 text-sv-cream ring-1 ring-sv-cream/20 backdrop-blur-sm transition duration-200 hover:scale-105 hover:bg-sv-jungle-deep active:scale-95"
            >
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="h-5 w-5"
              >
                <path d="M8 3H5a2 2 0 0 0-2 2v3" />
                <path d="M16 3h3a2 2 0 0 1 2 2v3" />
                <path d="M8 21H5a2 2 0 0 1-2-2v-3" />
                <path d="M16 21h3a2 2 0 0 0 2-2v-3" />
              </svg>
            </button>
          </div>

          {img.caption && (
            <figcaption class:list={['mt-4 text-center text-sm font-medium', tone.caption]}>
              {img.caption}
            </figcaption>
          )}
        </div>
      </figure>
    ))
  }
</CarouselShell>
