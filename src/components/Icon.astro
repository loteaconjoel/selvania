---
import { icons, type IconName } from '../lib/icons';

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: extraClass = 'h-6 w-6' } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class:list={[extraClass]}
>
  {icons[name].map((d) => <path d={d} />)}
</svg>
