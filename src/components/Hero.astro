---
import CtaButton from './CtaButton.astro';
import VideoPlayer from './VideoPlayer.astro';
import type { SiteContent } from '../data/types';

interface Props {
  hero: SiteContent['hero'];
  number: string;
}

const { hero, number } = Astro.props;
---

<section class="relative overflow-hidden px-4 pt-10 pb-14 sm:px-6 lg:pt-16 lg:pb-20">
  {/* Resplandor verde detrás del título, puramente decorativo. */}
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -top-40 left-1/2 h-96 w-[36rem] -translate-x-1/2 rounded-full bg-sv-lime/12 blur-3xl"
  >
  </div>

  <div class="relative mx-auto max-w-6xl">
    <div class="text-center">
      <h1
        class="font-heading text-4xl tracking-tight text-sv-cream uppercase sm:text-5xl lg:text-6xl"
      >
        {hero.brand}
      </h1>
      <p
        class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-balance text-sv-cream/80 sm:text-xl"
      >
        {hero.tagline}
      </p>
    </div>

    <div class="mx-auto mt-10 max-w-3xl">
      <VideoPlayer
        source={hero.video}
        poster={hero.poster}
        title={`${hero.brand}: video de presentación`}
        priority
      />
    </div>

    {/* En móvil los botones se apilan a ancho completo; en pantallas grandes,
        en dos columnas para no dejar una columna de botones gigante. */}
    <div class="mx-auto mt-8 grid max-w-3xl gap-3 sm:grid-cols-2">
      {hero.ctas.map((cta) => <CtaButton cta={cta} number={number} />)}
    </div>
  </div>
</section>
