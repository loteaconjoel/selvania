---
import CtaButton from './CtaButton.astro';
import VideoPlayer from './VideoPlayer.astro';
import type { SiteContent } from '../data/types';

interface Props {
  hero: SiteContent['hero'];
  number: string;
}

const { hero, number } = Astro.props;
---

<section class="relative overflow-hidden px-4 pt-10 pb-14 sm:px-6 lg:pt-24 lg:pb-28">
  {/* Resplandor verde detrás del título, puramente decorativo. */}
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -top-40 left-1/2 h-96 w-[36rem] -translate-x-1/2 rounded-full bg-sv-lime/12 blur-3xl"
  >
  </div>

  <div class="relative mx-auto max-w-6xl xl:max-w-7xl">
    <div class="text-center">
      <h1
        class="font-heading text-4xl tracking-tight text-sv-cream uppercase sm:text-5xl lg:text-6xl"
      >
        {hero.brand}
      </h1>
      <p
        class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-balance text-sv-cream/80 sm:text-xl lg:mt-6 lg:text-2xl"
      >
        {hero.tagline}
      </p>
    </div>

    <div class="mx-auto mt-10 max-w-3xl lg:mt-12 lg:max-w-4xl xl:max-w-5xl">
      <VideoPlayer
        source={hero.video}
        poster={hero.poster}
        title={`${hero.brand}: video de presentación`}
        priority
      />
    </div>

    {/* En móvil se apilan a ancho completo; en pantallas grandes van en fila y
        centrados. Antes era una rejilla de dos columnas y, al quedar un solo
        botón, se anclaba a la columna izquierda: en escritorio salía
        descentrado respecto al título y al video. */}
    <div
      class="mx-auto mt-8 flex max-w-3xl flex-col items-center gap-3 sm:flex-row sm:flex-wrap sm:justify-center lg:mt-10"
    >
      {
        hero.ctas.map((cta) => (
          <CtaButton cta={cta} number={number} block={false} class="w-full sm:w-auto" />
        ))
      }
    </div>
  </div>
</section>
