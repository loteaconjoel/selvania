---
import type { Cta } from '../data/types';
import { waLink } from '../lib/whatsapp';

interface Props {
  cta: Cta;
  number: string;
  /** Ocupa todo el ancho disponible. En móvil conviene dejarlo en true. */
  block?: boolean;
  class?: string;
}

const { cta, number, block = true, class: extraClass = '' } = Astro.props;

const styles: Record<Cta['style'], string> = {
  whatsapp: 'bg-sv-whatsapp text-white hover:brightness-110',
  lime: 'bg-sv-lime text-sv-jungle-deep hover:brightness-110',
  gold: 'bg-sv-gold text-sv-jungle-deep hover:brightness-110',
  outline:
    'border-2 border-sv-lime text-sv-lime hover:bg-sv-lime hover:text-sv-jungle-deep',
};
---

<a
  href={waLink(number, cta.message)}
  target="_blank"
  rel="noopener"
  data-cta={cta.label}
  class:list={[
    'inline-flex items-center justify-center gap-2.5 rounded-full px-7 py-4',
    'font-heading text-base font-bold tracking-wide uppercase',
    // 56px de alto mínimo: objetivo táctil cómodo en móvil.
    'min-h-14 text-center transition duration-200 active:scale-[0.98]',
    block ? 'w-full' : 'w-auto',
    styles[cta.style],
    extraClass,
  ]}
>
  <svg
    viewBox="0 0 24 24"
    fill="currentColor"
    aria-hidden="true"
    class="h-5 w-5 shrink-0"
  >
    <path
      d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.65.07-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.47-1.75-1.64-2.05-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.6-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.01-1.04 2.47s1.06 2.86 1.21 3.06c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.75-.72 2-1.41.25-.69.25-1.28.17-1.41-.07-.13-.27-.2-.57-.35Z"
    ></path>
    <path
      d="M12.04 2C6.6 2 2.17 6.43 2.17 11.87c0 1.74.46 3.44 1.32 4.94L2 22l5.33-1.4a9.83 9.83 0 0 0 4.7 1.2h.01c5.44 0 9.87-4.43 9.87-9.87S17.48 2 12.04 2Zm0 17.98h-.01a8.2 8.2 0 0 1-4.17-1.14l-.3-.18-3.1.81.83-3.02-.2-.31a8.14 8.14 0 0 1-1.25-4.35c0-4.52 3.68-8.2 8.2-8.2a8.2 8.2 0 0 1 8.2 8.2c0 4.52-3.68 8.19-8.2 8.19Z"
    ></path>
  </svg>
  <span>{cta.label}</span>
</a>
