---
import Icon from '../Icon.astro';
import type { MarqueeBlock } from '../../data/types';

interface Props {
  block: MarqueeBlock;
  alt: boolean;
}

const { block, alt } = Astro.props;

// Sobre el verde medio el contenido va oscuro (5.34:1) y sobre el verde profundo
// va en lima (10.16:1). Son las dos combinaciones con contraste comprobado.
const tono = alt
  ? {
      banda: 'border-sv-jungle-deep/20 bg-sv-jungle',
      icono: 'text-sv-jungle-deep',
      texto: 'text-sv-jungle-deep',
      punto: 'bg-sv-jungle-deep/50',
    }
  : {
      banda: 'border-sv-lime/20 bg-sv-jungle-deep',
      icono: 'text-sv-lime',
      texto: 'text-sv-cream',
      punto: 'bg-sv-lime/50',
    };

// Se renderiza la lista dos veces: cuando la pista se ha desplazado la mitad de
// su ancho, la segunda copia está exactamente donde arrancó la primera, así que
// el reinicio del ciclo es invisible.
const copies = [0, 1];
---

<div
  id={block.id}
  data-marquee
  class:list={['overflow-hidden border-y py-4', tono.banda]}
>
  <div class="sv-marquee-track flex w-max" data-motion="always">
    {
      copies.map((copy) => (
        <ul class="flex shrink-0 items-center" aria-hidden={copy === 1 ? 'true' : undefined}>
          {block.items.map((item) => (
            <li class="flex items-center gap-3 px-5">
              <Icon name={item.icon} class:list={['h-5 w-5 shrink-0', tono.icono]} />
              <span class:list={['font-heading text-sm font-bold tracking-wider whitespace-nowrap uppercase', tono.texto]}>
                {item.text}
              </span>
              <span class:list={['ml-5 h-1.5 w-1.5 rounded-full', tono.punto]} aria-hidden="true" />
            </li>
          ))}
        </ul>
      ))
    }
  </div>
</div>

<style>
  .sv-marquee-track {
    animation: sv-marquee 45s linear infinite;
  }

  /* No se detiene al pasar el dedo o el cursor: en móvil el toque llega como
     hover y la franja se quedaba congelada al desplazar la página con el dedo
     encima, que es justo cuando más se nota. */

  @keyframes sv-marquee {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  /* DECISIÓN DEL CLIENTE: la franja se mueve siempre, también con el ajuste de
     "reducir movimiento" activado en el sistema. Es parte de la identidad de la
     página y así se pidió expresamente.

     Hay que reafirmarla aquí porque global.css impone
     `animation-duration: 0.01ms !important` sobre todos los elementos en ese
     modo; sin esto la franja se congelaba. El selector de clase gana al
     selector universal aun estando ambos marcados como !important.

     Lo que esto implica: en Android el ajuste va atado al ahorro de batería, así
     que la animación seguirá corriendo en teléfonos con la batería baja, y
     tampoco se detendrá para quien lo haya activado por mareo con el
     movimiento. Se asume a conciencia. */
  @media (prefers-reduced-motion: reduce) {
    .sv-marquee-track {
      animation-name: sv-marquee !important;
      animation-duration: 45s !important;
      animation-timing-function: linear !important;
      animation-iteration-count: infinite !important;
      animation-play-state: running !important;
    }
  }
</style>

<script>
  // iOS pausa las animaciones CSS cuando la página pasa a segundo plano —al
  // cambiar de app o bloquear el móvil— y al volver no siempre las reanuda: la
  // franja se queda congelada. Aquí se comprueba cada vez que la página
  // recupera el foco y se le vuelve a dar marcha si quedó en pausa.
  //
  // Se usa getAnimations() en lugar de reiniciar la animación para que retome
  // justo donde estaba, sin dar un salto visible.
  function reanudarFranjas() {
    document.querySelectorAll<HTMLElement>('[data-marquee] .sv-marquee-track').forEach((pista) => {
      pista.getAnimations().forEach((animacion) => {
        if (animacion.playState === 'paused') animacion.play();
      });
    });
  }

  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) reanudarFranjas();
  });

  // pageshow cubre la vuelta atrás desde la caché del navegador, que en Safari
  // restaura la página tal cual estaba, animaciones pausadas incluidas.
  window.addEventListener('pageshow', reanudarFranjas);
  window.addEventListener('focus', reanudarFranjas);
</script>
