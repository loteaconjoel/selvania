---
import Icon from '../Icon.astro';
import type { MarqueeBlock } from '../../data/types';

interface Props {
  block: MarqueeBlock;
}

const { block } = Astro.props;

// Se renderiza la lista dos veces: cuando la pista se ha desplazado la mitad de
// su ancho, la segunda copia está exactamente donde arrancó la primera, así que
// el reinicio del ciclo es invisible.
const copies = [0, 1];
---

<div
  id={block.id}
  data-marquee
  class="overflow-hidden border-y border-sv-jungle-deep/20 bg-sv-jungle py-4"
>
  <div class="sv-marquee-track flex w-max">
    {
      copies.map((copy) => (
        <ul class="flex shrink-0 items-center" aria-hidden={copy === 1 ? 'true' : undefined}>
          {block.items.map((item) => (
            <li class="flex items-center gap-3 px-5">
              <Icon name={item.icon} class="h-5 w-5 shrink-0 text-sv-jungle-deep" />
              <span class="font-heading text-sm font-bold tracking-wider whitespace-nowrap text-sv-jungle-deep uppercase">
                {item.text}
              </span>
              <span class="ml-5 h-1.5 w-1.5 rounded-full bg-sv-jungle-deep/50" aria-hidden="true" />
            </li>
          ))}
        </ul>
      ))
    }
  </div>
</div>

<style>
  .sv-marquee-track {
    animation: sv-marquee 45s linear infinite;
  }

  /* No se detiene al pasar el dedo o el cursor: en móvil el toque llega como
     hover y la franja se quedaba congelada al desplazar la página con el dedo
     encima, que es justo cuando más se nota. */

  @keyframes sv-marquee {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  /* Con el movimiento reducido activado en el sistema, la franja deja de
     desplazarse. Antes se quedaba quieta a media frase, que parece un fallo;
     ahora las frases se reparten en varias líneas y se lee como una banda
     estática a propósito. La copia duplicada, que solo existe para que el
     bucle no tenga costura, sobra aquí. */
  @media (prefers-reduced-motion: reduce) {
    .sv-marquee-track {
      animation: none !important;
      width: auto;
      flex-wrap: wrap;
      justify-content: center;
    }

    .sv-marquee-track > ul[aria-hidden='true'] {
      display: none;
    }

    /* La lista lleva shrink-0 para que el bucle no la comprima. Aquí estorba:
       sin poder encoger se sale del contenedor y el recorte deja ver una sola
       frase. Se le devuelve la capacidad de encoger para que reparta las
       frases en varias líneas. */
    .sv-marquee-track > ul {
      flex-shrink: 1;
      min-width: 0;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.25rem 0;
    }

    /* Los puntos separan frases dentro de una tira continua. Apilada en
       líneas no separan nada y además sobresalen del borde. */
    .sv-marquee-track li > span[aria-hidden='true'] {
      display: none;
    }
  }
</style>

<script>
  // iOS pausa las animaciones CSS cuando la página pasa a segundo plano —al
  // cambiar de app o bloquear el móvil— y al volver no siempre las reanuda: la
  // franja se queda congelada. Aquí se comprueba cada vez que la página
  // recupera el foco y se le vuelve a dar marcha si quedó en pausa.
  //
  // Se usa getAnimations() en lugar de reiniciar la animación para que retome
  // justo donde estaba, sin dar un salto visible.
  function reanudarFranjas() {
    document.querySelectorAll<HTMLElement>('[data-marquee] .sv-marquee-track').forEach((pista) => {
      pista.getAnimations().forEach((animacion) => {
        if (animacion.playState === 'paused') animacion.play();
      });
    });
  }

  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) reanudarFranjas();
  });

  // pageshow cubre la vuelta atrás desde la caché del navegador, que en Safari
  // restaura la página tal cual estaba, animaciones pausadas incluidas.
  window.addEventListener('pageshow', reanudarFranjas);
  window.addEventListener('focus', reanudarFranjas);
</script>
