---
import Icon from '../Icon.astro';
import type { MarqueeBlock } from '../../data/types';

interface Props {
  block: MarqueeBlock;
}

const { block } = Astro.props;

// Se renderiza la lista dos veces: cuando la pista se ha desplazado la mitad de
// su ancho, la segunda copia está exactamente donde arrancó la primera, así que
// el reinicio del ciclo es invisible.
const copies = [0, 1];
---

<div
  id={block.id}
  data-marquee
  class="overflow-hidden border-y border-sv-jungle-deep/20 bg-sv-jungle py-4"
>
  <div class="sv-marquee-track flex w-max">
    {
      copies.map((copy) => (
        <ul class="flex shrink-0 items-center" aria-hidden={copy === 1 ? 'true' : undefined}>
          {block.items.map((item) => (
            <li class="flex items-center gap-3 px-5">
              <Icon name={item.icon} class="h-5 w-5 shrink-0 text-sv-jungle-deep" />
              <span class="font-heading text-sm font-bold tracking-wider whitespace-nowrap text-sv-jungle-deep uppercase">
                {item.text}
              </span>
              <span class="ml-5 h-1.5 w-1.5 rounded-full bg-sv-jungle-deep/50" aria-hidden="true" />
            </li>
          ))}
        </ul>
      ))
    }
  </div>
</div>

<style>
  .sv-marquee-track {
    animation: sv-marquee 45s linear infinite;
  }

  /* No se detiene al pasar el dedo o el cursor: en móvil el toque llega como
     hover y la franja se quedaba congelada al desplazar la página con el dedo
     encima, que es justo cuando más se nota. */

  @keyframes sv-marquee {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  /* Sin animación, la franja se vuelve deslizable a mano. */
  @media (prefers-reduced-motion: reduce) {
    .sv-marquee-track {
      animation: none !important;
    }

    [data-marquee] {
      overflow-x: auto;
    }
  }
</style>
