---
import SectionHeader from '../SectionHeader.astro';
import CtaButton from '../CtaButton.astro';
import Icon from '../Icon.astro';
import CarouselShell from '../CarouselShell.astro';
import JungleBackdrop from '../JungleBackdrop.astro';
import { surfaceOf } from '../../lib/surface';
import type { TextBlock } from '../../data/types';

interface Props {
  block: TextBlock;
  number: string;
  alt: boolean;
}

const { block, number, alt } = Astro.props;
const surface = surfaceOf(alt);
const variant = block.id.charCodeAt(0) % 3;

// Sobre el verde claro las tarjetas van en crema sólido: es el único tono claro
// que se separa del fondo (3.07:1), y deja el texto oscuro a 16:1 dentro.
const card = {
  dark: {
    box: 'bg-sv-cream/5 ring-1 ring-sv-lime/15',
    iconBox: 'bg-sv-lime/10 text-sv-lime ring-1 ring-sv-lime/25',
    title: 'text-sv-lime',
    text: 'text-sv-cream/75',
  },
  light: {
    box: 'bg-sv-cream ring-1 ring-sv-jungle-deep/10 shadow-lg shadow-sv-jungle-deep/20',
    iconBox: 'bg-sv-jungle-deep text-sv-lime',
    title: 'text-sv-jungle-deep',
    text: 'text-sv-jungle-deep/85',
  },
}[surface];
---

<section
  id={block.id}
  class:list={[
    'relative overflow-hidden py-16 sm:py-20 lg:py-32',
    alt ? 'bg-sv-jungle' : 'bg-sv-jungle-deep',
  ]}
>
  {alt && <JungleBackdrop variant={variant} />}

  <div class="relative px-4 sm:px-6">
    <div class="mx-auto max-w-6xl xl:max-w-7xl">
      <SectionHeader
        eyebrow={block.eyebrow}
        title={block.title}
        description={block.description}
        surface={surface}
      />
    </div>
  </div>

  {/* Los puntos se deslizan igual que las fotos del resto de secciones, y
      comparten sus márgenes: la primera tarjeta arranca en el mismo contorno
      que el título y lo que asoma por la derecha es la siguiente. */}
  <div class="relative mt-10 px-4 sm:px-6">
    <div class="mx-auto max-w-6xl xl:max-w-7xl">
      <CarouselShell label={block.title} surface={surface} dim="tarjeta" lightbox>
        {
          block.bullets.map((bullet) => (
            <article class="flex min-w-0 shrink-0 grow-0 basis-[88%] pl-3 sm:basis-[56%] sm:pl-5 lg:basis-[36%] xl:basis-[31%]">
              {/* El escalado va en este envoltorio y no en el <article>: si se
                  aplica al artículo, su relleno se encoge con él y la tarjeta
                  vecina se desplaza encima de la activa. */}
              <div data-slide class="flex w-full transition-[transform,filter] duration-500">
                <div
                  class:list={[
                    'flex w-full flex-col overflow-hidden rounded-3xl',
                    card.box,
                  ]}
                >
                  {bullet.image?.src && (
                    <div class="relative aspect-4/3 shrink-0 overflow-hidden bg-sv-jungle-deep">
                      <img
                        src={bullet.image.src}
                        alt={bullet.image.alt}
                        loading="lazy"
                        decoding="async"
                        class="h-full w-full object-cover"
                      />

                      <button
                        type="button"
                        data-zoom
                        data-src={bullet.image.src}
                        data-alt={bullet.image.alt}
                        data-caption={bullet.title}
                        aria-label={`Ampliar: ${bullet.title}`}
                        class="absolute top-3 right-3 grid h-10 w-10 place-items-center rounded-full bg-sv-jungle-deep/70 text-sv-cream ring-1 ring-sv-cream/20 backdrop-blur-sm transition duration-200 hover:scale-105 hover:bg-sv-jungle-deep active:scale-95"
                      >
                        <svg
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          class="h-5 w-5"
                        >
                          <path d="M8 3H5a2 2 0 0 0-2 2v3" />
                          <path d="M16 3h3a2 2 0 0 1 2 2v3" />
                          <path d="M8 21H5a2 2 0 0 1-2-2v-3" />
                          <path d="M16 21h3a2 2 0 0 0 2-2v-3" />
                        </svg>
                      </button>
                    </div>
                  )}

                  <div class="flex flex-1 flex-col p-6">
                    <span
                      class:list={['grid h-11 w-11 shrink-0 place-items-center rounded-xl', card.iconBox]}
                    >
                      <Icon name={bullet.icon} class="h-6 w-6" />
                    </span>
                    <h3 class:list={['mt-4 font-heading text-lg font-bold', card.title]}>
                      {bullet.title}
                    </h3>
                    <p class:list={['mt-2 text-sm leading-relaxed', card.text]}>{bullet.text}</p>
                  </div>
                </div>
              </div>
            </article>
          ))
        }
      </CarouselShell>
    </div>
  </div>

  {
    block.cta && (
      <div class="relative mt-10 flex justify-center px-4 sm:px-6">
        <CtaButton
          cta={block.cta}
          number={number}
          surface={surface}
          block={false}
          class="w-full sm:w-auto"
        />
      </div>
    )
  }
</section>
