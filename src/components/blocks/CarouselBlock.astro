---
import SectionHeader from '../SectionHeader.astro';
import CtaButton from '../CtaButton.astro';
import Carousel from '../Carousel.astro';
import JungleBackdrop from '../JungleBackdrop.astro';
import { surfaceOf } from '../../lib/surface';
import type { CarouselBlock } from '../../data/types';

interface Props {
  block: CarouselBlock;
  number: string;
  alt: boolean;
}

const { block, number, alt } = Astro.props;
const surface = surfaceOf(alt);
const variant = block.id.charCodeAt(0) % 3;
---

<section
  id={block.id}
  class:list={[
    'relative overflow-hidden py-16 sm:py-20 lg:py-32',
    alt ? 'bg-sv-jungle' : 'bg-sv-jungle-deep',
  ]}
>
  {alt && <JungleBackdrop variant={variant} />}
  <div class="relative px-4 sm:px-6">
    <div class="mx-auto max-w-6xl xl:max-w-7xl">
      <SectionHeader
        eyebrow={block.eyebrow}
        title={block.title}
        description={block.description}
        surface={surface}
      />
    </div>
  </div>

  {/* El carrusel comparte márgenes con el título y el texto: antes se salía por
      la izquierda y la foto anterior quedaba cortada a media altura contra el
      borde de la pantalla. Ahora la foto activa arranca en el mismo contorno y
      lo que asoma es la siguiente, por la derecha, que es lo que invita a
      deslizar. */}
  <div class="relative mt-10 px-4 sm:px-6">
    <div class="mx-auto max-w-6xl xl:max-w-7xl">
      <Carousel images={block.images} label={block.title} surface={surface} />
    </div>
  </div>

  {
    block.cta && (
      <div class="relative mt-10 flex justify-center px-4 sm:px-6">
        <CtaButton
          cta={block.cta}
          number={number}
          surface={surface}
          block={false}
          class="w-full sm:w-auto"
        />
      </div>
    )
  }
</section>
