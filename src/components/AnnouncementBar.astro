---
interface Props {
  html: string;
}

const { html } = Astro.props;
---

{/* Barra de urgencia. El texto admite <strong> desde el CMS. */}
<div class="bg-sv-jungle-deep px-4 py-2.5 text-center">
  <p
    class="text-[11px] leading-snug font-semibold tracking-wider text-sv-cream/85 uppercase sm:text-xs [&_strong]:text-sv-lime"
    set:html={html}
  />
</div>
