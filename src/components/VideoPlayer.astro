---
import type { VideoSource } from '../data/types';
import type { Surface } from '../lib/surface';

interface Props {
  source: VideoSource;
  poster?: string;
  title: string;
  surface?: Surface;
  /**
   * Para el video de la cabecera. Su portada es lo primero que se ve, así que
   * se pide de inmediato en vez de diferirla: diferir la imagen principal es
   * justo lo que hace que la página parezca lenta al abrir.
   */
  priority?: boolean;
}

const { source, poster, title, surface = 'dark', priority = false } = Astro.props;

// En YouTube, si no hay portada propia se usa la miniatura del propio video.
const cover =
  poster ??
  (source.kind === 'youtube'
    ? `https://i.ytimg.com/vi/${source.youtubeId}/hqdefault.jpg`
    : undefined);

const frame = {
  dark: 'ring-1 ring-sv-lime/25 shadow-2xl shadow-black/60',
  light: 'ring-1 ring-sv-jungle-deep/30 shadow-2xl shadow-sv-jungle-deep/40',
}[surface];
---

{/* Fachada: hasta que no se toca play no se descarga ni el reproductor de
    YouTube ni el video propio. En móvil con datos, esto es la diferencia entre
    una página que abre al instante y una que tarda. */}
<div
  data-video
  data-kind={source.kind}
  data-src={source.kind === 'youtube' ? source.youtubeId : source.src}
  class:list={[
    'group relative aspect-video w-full cursor-pointer overflow-hidden rounded-3xl bg-sv-jungle-deep',
    frame,
  ]}
>
  {
    cover ? (
      <img
        src={cover}
        alt={title}
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : undefined}
        decoding="async"
        class="absolute inset-0 h-full w-full object-cover transition duration-700 group-hover:scale-105"
      />
    ) : null
  }

  {/* Velo oscuro: la portada puede ser un cielo claro, y sin esto el botón de
      play se perdería encima. Con él, el contraste está garantizado sea cual
      sea la foto que suba el cliente. */}
  <div
    class="absolute inset-0 bg-gradient-to-t from-sv-jungle-deep/80 via-sv-jungle-deep/25 to-sv-jungle-deep/40"
    aria-hidden="true"
  >
  </div>

  <button
    type="button"
    aria-label={`Reproducir: ${title}`}
    class="absolute inset-0 grid place-items-center"
  >
    <span class="relative grid place-items-center">
      {/* Halo que late para atraer el toque. Se detiene si el sistema pide
          reducir el movimiento. */}
      <span
        class="absolute h-20 w-20 animate-ping rounded-full bg-sv-lime/25 motion-reduce:hidden"
        aria-hidden="true"
      ></span>
      <span
        class="relative grid h-20 w-20 place-items-center rounded-full bg-sv-lime text-sv-jungle-deep shadow-2xl shadow-black/50 ring-4 ring-sv-cream/15 transition duration-300 group-hover:scale-110"
      >
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="ml-1 h-9 w-9">
          <path d="M8 5.14v13.72L19 12 8 5.14Z"></path>
        </svg>
      </span>
    </span>
  </button>

  <span
    class="pointer-events-none absolute bottom-4 left-4 rounded-full bg-sv-jungle-deep/75 px-3.5 py-1.5 font-heading text-xs font-bold tracking-wider text-sv-cream uppercase backdrop-blur-sm"
  >
    Ver video
  </span>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-video]').forEach((facade) => {
    facade.addEventListener(
      'click',
      () => {
        const { kind, src } = facade.dataset;
        if (!src) return;

        let player: HTMLElement;

        if (kind === 'youtube') {
          const iframe = document.createElement('iframe');
          // El dominio -nocookie evita el rastreo de quien solo ve el video.
          iframe.src = `https://www.youtube-nocookie.com/embed/${src}?autoplay=1&rel=0&modestbranding=1`;
          iframe.title = 'Video de Selvania Park';
          iframe.allow =
            'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
          iframe.allowFullscreen = true;
          player = iframe;
        } else {
          const video = document.createElement('video');
          video.src = src;
          video.controls = true;
          video.autoplay = true;
          video.playsInline = true;
          player = video;
        }

        player.className = 'absolute inset-0 h-full w-full border-0 object-cover';
        facade.replaceChildren(player);
        facade.classList.remove('cursor-pointer', 'group');
      },
      { once: true },
    );
  });
</script>
