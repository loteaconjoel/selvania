---
import VideoBlock from './blocks/VideoBlock.astro';
import CarouselBlock from './blocks/CarouselBlock.astro';
import ShowcaseBlock from './blocks/ShowcaseBlock.astro';
import TextBlock from './blocks/TextBlock.astro';
import MarqueeBlock from './blocks/MarqueeBlock.astro';
import type { Block } from '../data/types';

interface Props {
  blocks: Block[];
  number: string;
}

const { blocks, number } = Astro.props;

// Las secciones ocultas desde el CMS no llegan al HTML.
const visible = blocks.filter((block) => block.enabled);

// El fondo alterna entre los dos verdes para separar una sección de la
// siguiente, salvo que la sección haya elegido el suyo desde el panel.
// Las franjas no entran en la alternancia: son bandas delgadas y la romperían
// para las secciones que las rodean.
let contentIndex = 0;
const prepared = visible.map((block) => {
  if (block.type === 'marquee') {
    // La banda va en verde medio salvo que se pida oscura.
    return { block, alt: block.surface !== 'dark' };
  }

  // Empieza en oscuro para no repetir el fondo del hero.
  const automatico = contentIndex % 2 === 1;
  contentIndex += 1;

  const alt =
    block.surface === 'light' ? true : block.surface === 'dark' ? false : automatico;

  return { block, alt };
});
---

{
  prepared.map(({ block, alt }) => {
    switch (block.type) {
      case 'marquee':
        return <MarqueeBlock block={block} alt={alt} />;
      case 'video':
        return <VideoBlock block={block} number={number} alt={alt} />;
      case 'carousel':
        return <CarouselBlock block={block} number={number} alt={alt} />;
      case 'showcase':
        return <ShowcaseBlock block={block} number={number} alt={alt} />;
      case 'text':
        return <TextBlock block={block} number={number} alt={alt} />;
    }
  })
}
