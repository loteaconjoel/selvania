---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
}

const { eyebrow, title, description } = Astro.props;
---

<header class="mx-auto max-w-3xl text-center">
  {
    eyebrow && (
      <p class="font-heading text-sm font-bold tracking-[0.2em] text-sv-gold uppercase">
        {eyebrow}
      </p>
    )
  }
  <h2 class="mt-3 text-3xl text-sv-cream sm:text-4xl lg:text-5xl">{title}</h2>
  {
    description && (
      <p class="mx-auto mt-5 max-w-2xl text-base leading-relaxed text-sv-cream/75 sm:text-lg">
        {description}
      </p>
    )
  }
</header>
