---
interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<section class="rounded-2xl bg-sv-cream/5 p-5 ring-1 ring-sv-lime/15 sm:p-6">
  <h2 class="font-heading text-lg font-bold text-sv-cream">{title}</h2>
  {description && <p class="mt-1 text-sm text-sv-cream/55">{description}</p>}
  <div class="mt-5">
    <slot />
  </div>
</section>
