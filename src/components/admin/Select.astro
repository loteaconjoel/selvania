---
interface Props {
  label: string;
  name: string;
  value: string;
  options: { value: string; label: string }[];
  hint?: string;
  wide?: boolean;
}

const { label, name, value, options, hint, wide = false } = Astro.props;
---

<label class:list={['block', wide && 'sm:col-span-2']}>
  <span class="text-xs font-semibold tracking-wide text-sv-cream/70 uppercase">{label}</span>
  <select
    name={name}
    class="mt-1.5 w-full rounded-xl bg-sv-cream/5 px-3.5 py-2.5 text-sm text-sv-cream ring-1 ring-sv-lime/20 outline-none focus:ring-2 focus:ring-sv-lime"
  >
    {
      options.map((option) => (
        <option value={option.value} selected={option.value === value}>
          {option.label}
        </option>
      ))
    }
  </select>
  {hint && <span class="mt-1.5 block text-xs text-sv-cream/45">{hint}</span>}
</label>
