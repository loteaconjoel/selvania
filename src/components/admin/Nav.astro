---
interface Props {
  admin?: string;
}

const { admin } = Astro.props;
const path = Astro.url.pathname;

const links = [
  { href: '/admin', label: 'Secciones' },
  { href: '/admin/general', label: 'General' },
  { href: '/admin/tema', label: 'Tema' },
];

const isActive = (href: string) => (href === '/admin' ? path === '/admin' : path.startsWith(href));
---

{/* Dos filas fijas: marca y salida arriba, pestañas debajo. Antes iba todo en
    una sola fila que se envolvía, y en el móvil «Tema» caía suelto en su propia
    línea, descolgado del resto. */}
<header class="border-b border-sv-lime/15 bg-sv-jungle-deep/80">
  <div class="mx-auto max-w-4xl px-4 py-3.5 sm:px-6">
    <div class="flex items-center justify-between gap-4">
      <a
        href="/admin"
        class="font-heading text-sm font-bold tracking-wide text-sv-lime uppercase"
      >
        Selvania Park
      </a>

      <div class="flex shrink-0 items-center gap-3">
        <a
          href="/"
          target="_blank"
          rel="noopener"
          class="hidden text-xs text-sv-cream/50 underline-offset-4 hover:text-sv-lime hover:underline sm:block"
        >
          Ver la web
        </a>
        <form method="POST" action="/api/logout">
          <button
            type="submit"
            class="rounded-full border border-sv-lime/35 px-3.5 py-1.5 text-xs font-semibold text-sv-lime transition hover:bg-sv-lime hover:text-sv-jungle-deep"
          >
            Salir{admin ? ` (${admin})` : ''}
          </button>
        </form>
      </div>
    </div>

    <nav class="mt-3 flex gap-1.5">
      {
        links.map((link) => (
          <a
            href={link.href}
            aria-current={isActive(link.href) ? 'page' : undefined}
            class:list={[
              'rounded-full px-4 py-1.5 text-sm font-semibold transition',
              isActive(link.href)
                ? 'bg-sv-lime text-sv-jungle-deep'
                : 'text-sv-cream/70 hover:bg-sv-cream/10 hover:text-sv-cream',
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
