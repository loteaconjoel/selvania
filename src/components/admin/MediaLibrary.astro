---
import { listMedia } from '../../lib/content-store';

const imagenes = await listMedia();
---

{
  imagenes.length > 0 && (
    <div class="mt-5">
      <p class="text-xs font-semibold tracking-wide text-sv-cream/70 uppercase">
        Imágenes ya subidas
      </p>
      <p class="mt-1 text-xs text-sv-cream/45">
        Pulsa una para copiar su ruta y pégala en el campo que quieras.
      </p>

      <ul class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
        {imagenes.map((imagen) => (
          <li>
            <button
              type="button"
              data-copiar={imagen.url}
              title={imagen.name}
              class="group block w-full overflow-hidden rounded-xl bg-sv-jungle-deep/60 text-left ring-1 ring-sv-lime/15 transition hover:ring-sv-lime/50"
            >
              <img
                src={imagen.url}
                alt=""
                loading="lazy"
                decoding="async"
                class="aspect-4/3 w-full object-cover"
              />
              <span class="flex items-center justify-between gap-2 px-2.5 py-2">
                <span class="truncate text-xs text-sv-cream/70">{imagen.name}</span>
                <span
                  data-etiqueta
                  class="shrink-0 text-xs font-semibold text-sv-lime opacity-0 transition group-hover:opacity-100"
                >
                  Copiar
                </span>
              </span>
            </button>
          </li>
        ))}
      </ul>
    </div>
  )
}

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copiar]').forEach((boton) => {
    const etiqueta = boton.querySelector<HTMLElement>('[data-etiqueta]');

    boton.addEventListener('click', async () => {
      const ruta = boton.dataset.copiar ?? '';

      try {
        await navigator.clipboard.writeText(ruta);
      } catch {
        // El portapapeles falla si el navegador es antiguo o la página no va por
        // HTTPS. En ese caso se deja la ruta seleccionada para copiarla a mano.
        const campo = document.createElement('input');
        campo.value = ruta;
        campo.setAttribute('readonly', '');
        campo.className = 'fixed top-0 left-0 opacity-0';
        document.body.append(campo);
        campo.select();
        window.setTimeout(() => campo.remove(), 8000);
      }

      if (!etiqueta) return;
      etiqueta.textContent = '¡Copiada!';
      etiqueta.classList.add('opacity-100');
      window.setTimeout(() => {
        etiqueta.textContent = 'Copiar';
        etiqueta.classList.remove('opacity-100');
      }, 1600);
    });
  });
</script>
