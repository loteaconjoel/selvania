---
import { canPersist } from '../../lib/content-store';

const url = Astro.url;

const success: Record<string, string> = {
  guardado: 'Cambios guardados.',
  creada: 'Sección creada. Está oculta hasta que la actives.',
  eliminada: 'Sección eliminada.',
  restablecido: 'Se restauró el contenido de fábrica.',
  imagen: 'Imagen subida. Copia la ruta y pégala donde la necesites.',
};

const errors: Record<string, string> = {
  'sin-almacenamiento':
    'Este entorno no permite guardar: falta conectar una base de datos. Los cambios no se han aplicado.',
  'sin-archivo': 'No se seleccionó ningún archivo.',
  formato: 'Formato no admitido. Usa JPG, PNG, WebP, AVIF o GIF.',
  tamano: 'La imagen pesa más de 8 MB. Reduce su tamaño antes de subirla.',
  'no-existe': 'Esa sección ya no existe.',
  orden: 'La sección ya está en el extremo.',
  tipo: 'Tipo de sección desconocido.',
  accion: 'Acción desconocida.',
  guardar: 'No se pudo guardar. Revisa los permisos del archivo data/content.json.',
};

const ok = success[url.searchParams.get('ok') ?? ''];
const error = errors[url.searchParams.get('e') ?? ''];
const uploaded = url.searchParams.get('url');
---

{
  !canPersist && (
    <p class="rounded-xl bg-red-500/10 px-4 py-3 text-sm text-red-300 ring-1 ring-red-500/30">
      <strong>El panel está en modo lectura.</strong> Este entorno tiene el disco en
      solo lectura, así que nada de lo que guardes se conservará. Hace falta
      conectar una base de datos antes de administrar desde aquí.
    </p>
  )
}

{
  error && (
    <p role="alert" class="rounded-xl bg-red-500/10 px-4 py-3 text-sm text-red-300 ring-1 ring-red-500/30">
      {error}
    </p>
  )
}

{
  ok && (
    <p role="status" class="rounded-xl bg-sv-lime/10 px-4 py-3 text-sm text-sv-lime ring-1 ring-sv-lime/30">
      {ok}
      {uploaded && (
        <>
          {' '}
          <code class="rounded bg-sv-jungle-deep/60 px-1.5 py-0.5 font-mono text-xs break-all">
            {uploaded}
          </code>
        </>
      )}
    </p>
  )
}
