---
import '../styles/global.css';
import ThemeStyle from '../components/ThemeStyle.astro';
import { googleFontsUrl } from '../lib/whatsapp';
import type { SiteContent } from '../data/types';

interface Props {
  site: SiteContent;
}

const { site } = Astro.props;
const fontsHref = googleFontsUrl(site.theme.fonts.heading, site.theme.fonts.body);
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const ogImage = new URL(site.seo.ogImage, canonical);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{site.seo.title}</title>
    <meta name="description" content={site.seo.description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!-- Tarjeta de previsualización al compartir el enlace por WhatsApp. -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.hero.brand} />
    <meta property="og:title" content={site.seo.title} />
    <meta property="og:description" content={site.seo.description} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:locale" content="es_PE" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fontsHref} />
    <!-- La miniatura del video se pide apenas carga la página. -->
    <link rel="preconnect" href="https://i.ytimg.com" />

    <ThemeStyle theme={site.theme} />
  </head>
  <body>
    <slot />
  </body>
</html>
