---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Nav from '../../components/admin/Nav.astro';
import Notice from '../../components/admin/Notice.astro';
import Step from '../../components/admin/Step.astro';
import Field from '../../components/admin/Field.astro';
import Select from '../../components/admin/Select.astro';
import MediaPicker from '../../components/admin/MediaPicker.astro';
import VideoFields from '../../components/admin/VideoFields.astro';
import { readContent } from '../../lib/content-store';

export const prerender = false;

const content = await readContent();
const { seo, announcement, hero, whatsapp, footer } = content;

const HERE = '/admin/general';

const ctaStyles = [
  { value: 'whatsapp', label: 'Verde WhatsApp' },
  { value: 'lime', label: 'Verde lima' },
  { value: 'gold', label: 'Verde claro' },
  { value: 'outline', label: 'Solo contorno' },
];

// Una fila vacía al final para poder añadir sin recargar nada.
const ctaRows = [...hero.ctas.map((cta, i) => ({ cta, i })), { cta: null, i: hero.ctas.length }];
const linkRows = [
  ...footer.links.map((link, i) => ({ link, i })),
  { link: null, i: footer.links.length },
];

const rowBox = 'rounded-xl bg-sv-jungle-deep/60 p-4 ring-1 ring-sv-lime/10';
const deleteLabel = 'flex items-center gap-2 text-xs font-semibold text-red-300';
const orderInput =
  'w-16 rounded-lg bg-sv-cream/5 px-2 py-1 text-sm text-sv-cream ring-1 ring-sv-lime/20 outline-none focus:ring-2 focus:ring-sv-lime';

// Mismo índice que en el editor de secciones, con lo que hay puesto en cada uno.
const apartados = [
  { id: 'barra', nombre: 'Barra superior', estado: announcement.enabled ? 'Visible' : 'Oculta' },
  { id: 'cabecera', nombre: 'Cabecera', estado: hero.brand },
  {
    id: 'botones',
    nombre: 'Botones de la cabecera',
    estado: hero.ctas.length === 1 ? '1 botón' : `${hero.ctas.length} botones`,
  },
  { id: 'contacto', nombre: 'WhatsApp de contacto', estado: `+${whatsapp.number}` },
  { id: 'compartir', nombre: 'Google y al compartir', estado: seo.title.slice(0, 28) + '…' },
  {
    id: 'pie',
    nombre: 'Pie de página',
    estado: footer.links.length === 1 ? '1 enlace' : `${footer.links.length} enlaces`,
  },
];
---

<AdminLayout title="General">
  <Nav admin={Astro.locals.admin} />

  <div class="mx-auto max-w-4xl space-y-6 px-4 py-8 sm:px-6">
    <Notice />

    <header class="flex flex-wrap items-start justify-between gap-4">
      <div class="min-w-0">
        <h1 class="font-heading text-2xl text-sv-cream">General</h1>
        <p class="mt-1.5 max-w-2xl text-sm text-sv-cream/60">
          Todo lo que no pertenece a una sección concreta: la barra de arriba, la
          cabecera, el número de contacto y el pie. Las secciones se editan una a una
          desde <a href="/admin" class="text-sv-lime underline-offset-4 hover:underline">Secciones</a>.
        </p>
      </div>

      <a
        href="/"
        target="_blank"
        rel="noopener"
        class="shrink-0 rounded-full border border-sv-lime/35 px-4 py-2 text-xs font-semibold text-sv-lime transition hover:bg-sv-lime hover:text-sv-jungle-deep"
      >
        Ver en la web
      </a>
    </header>

    <nav class="rounded-2xl bg-sv-jungle-deep/60 p-5 ring-1 ring-sv-lime/10">
      <p class="font-heading text-sm font-bold text-sv-cream">Qué hay en esta pantalla</p>
      <p class="mt-1 text-xs text-sv-cream/50">De arriba abajo, igual que en la web.</p>

      <ol class="mt-4 space-y-1.5">
        {
          apartados.map((apartado, i) => (
            <li>
              <a
                href={`#paso-${apartado.id}`}
                class="flex items-center gap-3 rounded-lg px-2 py-1.5 transition hover:bg-sv-cream/5"
              >
                <span class="w-5 shrink-0 text-right font-heading text-xs font-bold text-sv-lime">
                  {i + 1}
                </span>
                <span class="min-w-0 flex-1 truncate text-sm text-sv-cream/85">
                  {apartado.nombre}
                </span>
                <span class="shrink-0 truncate text-xs text-sv-cream/50" style="max-width:11rem">
                  {apartado.estado}
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    <form method="POST" action="/api/admin/guardar" class="space-y-5">
      <input type="hidden" name="accion" value="general" />
      <input type="hidden" name="volver" value={HERE} />

      <div id="paso-barra">
        <Step
          n={1}
          title="Barra superior"
          where="La franja fina de arriba del todo, antes del nombre"
          description="Admite <strong>negrita</strong> escribiendo la palabra entre esas etiquetas."
          badge={announcement.enabled ? 'Visible' : 'Oculta'}
          optional
        >
          <label class="mb-4 flex items-center gap-2.5 text-sm text-sv-cream/85">
            <input
              type="checkbox"
              name="announcement.enabled"
              checked={announcement.enabled}
              class="h-4 w-4 accent-sv-lime"
            />
            Mostrar la barra
          </label>
          <Field
            label="Texto"
            name="announcement.html"
            value={announcement.html}
            type="textarea"
            rows={2}
          />
        </Step>
      </div>

      <div id="paso-cabecera">
        <Step
          n={2}
          title="Cabecera"
          where="Lo primero que se ve: nombre, frase y video"
          badge={hero.brand}
        >
          <div class="grid gap-4 sm:grid-cols-2">
            <Field
              label="Nombre del proyecto"
              name="hero.brand"
              value={hero.brand}
              hint="Sale en grande arriba y también en el pie."
            />
            <Field
              label="Frase de entrada"
              name="hero.tagline"
              value={hero.tagline}
              type="textarea"
              rows={2}
              hint="La frase bajo el nombre."
              wide
            />
          </div>

          <div class="mt-5 border-t border-sv-lime/10 pt-5">
            <p class="mb-4 text-xs font-semibold tracking-wide text-sv-cream/70 uppercase">
              Video de presentación
            </p>
            <VideoFields
              prefix="hero.video"
              source={hero.video}
              poster={hero.poster}
              posterName="hero.poster"
            />
            <MediaPicker />
          </div>
        </Step>
      </div>

      <div id="paso-botones">
        <Step
          n={3}
          title="Botones de la cabecera"
          where="Justo debajo del video"
          description="Cada botón abre WhatsApp con un mensaje ya escrito. Para quitar uno, marca Eliminar o deja su texto vacío."
          badge={hero.ctas.length === 1 ? '1 botón' : `${hero.ctas.length} botones`}
        >
          <div class="space-y-4">
            {
              ctaRows.map(({ cta, i }) => (
                <div class={rowBox}>
                  <div class="grid gap-4 sm:grid-cols-2">
                    <Field
                      label={cta ? `Botón ${i + 1}` : 'Añadir otro botón'}
                      name={`cta.${i}.label`}
                      value={cta?.label ?? ''}
                      placeholder="¡Agenda tu visita!"
                    />
                    <Select
                      label="Color"
                      name={`cta.${i}.style`}
                      value={cta?.style ?? 'whatsapp'}
                      options={ctaStyles}
                    />
                    <Field
                      label="Mensaje que se escribe solo"
                      name={`cta.${i}.message`}
                      value={cta?.message ?? ''}
                      type="textarea"
                      rows={2}
                      hint="Menciona de dónde viene, para reconocer el origen del contacto."
                      wide
                    />
                  </div>
                  <div class="mt-3 flex flex-wrap items-center gap-5">
                    <label class="flex items-center gap-2 text-xs text-sv-cream/55">
                      Orden
                      <input
                        type="number"
                        name={`cta.${i}.orden`}
                        value={String(i)}
                        class={orderInput}
                      />
                    </label>
                    {cta && (
                      <label class={deleteLabel}>
                        <input
                          type="checkbox"
                          name={`cta.${i}.borrar`}
                          class="h-4 w-4 accent-red-400"
                        />
                        Eliminar
                      </label>
                    )}
                  </div>
                </div>
              ))
            }
          </div>
        </Step>
      </div>

      <div id="paso-contacto">
        <Step
          n={4}
          title="WhatsApp de contacto"
          where="Todos los botones de toda la página escriben a este número"
          badge={`+${whatsapp.number}`}
        >
          <Field
            label="Número"
            name="whatsapp.number"
            value={whatsapp.number}
            hint="Con código de país y sin espacios ni signos. Para Perú, el 51 delante: 51939210162."
          />
        </Step>
      </div>

      <div id="paso-compartir">
        <Step
          n={5}
          title="Google y al compartir el enlace"
          where="No se ve en la página: es lo que aparece en Google y en la tarjeta de WhatsApp"
          badge={seo.title.slice(0, 24) + '…'}
        >
          <div class="grid gap-4">
            <Field
              label="Título"
              name="seo.title"
              value={seo.title}
              hint="Lo que se lee como titular en los resultados de Google."
            />
            <Field
              label="Descripción"
              name="seo.description"
              value={seo.description}
              type="textarea"
              rows={2}
              hint="El párrafo bajo el titular. Dos líneas bastan."
            />
            <Field
              label="Imagen al compartir"
              name="seo.ogImage"
              value={seo.ogImage}
              hint="1200x630 px, en JPG o PNG. WhatsApp no muestra imágenes SVG."
            />
          </div>

          <MediaPicker />
        </Step>
      </div>

      <div id="paso-pie">
        <Step
          n={6}
          title="Pie de página"
          where="El bloque final, bajo la última sección"
          badge={footer.links.length === 1 ? '1 enlace' : `${footer.links.length} enlaces`}
        >
          <Field
            label="Texto"
            name="footer.text"
            value={footer.text}
            placeholder="Selvania Park — Pichanaki, Junín, Perú"
          />

          <div class="mt-4 space-y-4">
            {
              linkRows.map(({ link, i }) => (
                <div class={rowBox}>
                  <div class="grid gap-4 sm:grid-cols-2">
                    <Field
                      label={link ? `Enlace ${i + 1}` : 'Añadir otro enlace'}
                      name={`link.${i}.label`}
                      value={link?.label ?? ''}
                      placeholder="Política de privacidad"
                    />
                    <Field
                      label="Destino"
                      name={`link.${i}.href`}
                      value={link?.href ?? ''}
                      placeholder="/privacidad"
                    />
                  </div>
                  {link && (
                    <label class={`mt-3 ${deleteLabel}`}>
                      <input
                        type="checkbox"
                        name={`link.${i}.borrar`}
                        class="h-4 w-4 accent-red-400"
                      />
                      Eliminar
                    </label>
                  )}
                </div>
              ))
            }
          </div>
        </Step>
      </div>

      {/* Marca de fin de formulario. El servidor la exige para guardar: si no
          llega, es que el navegador cortó el formulario y faltan campos. */}
      <input type="hidden" name="formulario" value="completo" />

      <div
        class="sticky bottom-0 -mx-4 border-t border-sv-lime/15 bg-sv-jungle-deep/95 px-4 py-4 backdrop-blur sm:-mx-6 sm:px-6"
      >
        <div class="flex flex-wrap items-center justify-between gap-3">
          <p class="text-xs text-sv-cream/50">Nada cambia en la web hasta que guardes.</p>
          <button
            type="submit"
            class="rounded-full bg-sv-lime px-7 py-3 font-heading text-sm font-bold tracking-wide text-sv-jungle-deep uppercase transition hover:brightness-110"
          >
            Guardar cambios
          </button>
        </div>
      </div>
    </form>
  </div>
</AdminLayout>
