---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Nav from '../../components/admin/Nav.astro';
import Notice from '../../components/admin/Notice.astro';
import Card from '../../components/admin/Card.astro';
import Field from '../../components/admin/Field.astro';
import Select from '../../components/admin/Select.astro';
import Uploader from '../../components/admin/Uploader.astro';
import VideoFields from '../../components/admin/VideoFields.astro';
import { readContent } from '../../lib/content-store';

export const prerender = false;

const content = await readContent();
const { seo, announcement, hero, whatsapp, footer } = content;

const HERE = '/admin/general';

const ctaStyles = [
  { value: 'whatsapp', label: 'Verde WhatsApp' },
  { value: 'lime', label: 'Verde lima' },
  { value: 'gold', label: 'Dorado' },
  { value: 'outline', label: 'Solo contorno' },
];

// Una fila vacía al final para poder añadir sin recargar nada.
const ctaRows = [...hero.ctas.map((cta, i) => ({ cta, i })), { cta: null, i: hero.ctas.length }];
const linkRows = [
  ...footer.links.map((link, i) => ({ link, i })),
  { link: null, i: footer.links.length },
];

const rowBox = 'rounded-xl bg-sv-jungle-deep/60 p-4 ring-1 ring-sv-lime/10';
const deleteLabel = 'flex items-center gap-2 text-xs font-semibold text-red-300';
---

<AdminLayout title="General">
  <Nav admin={Astro.locals.admin} />

  <div class="mx-auto max-w-4xl space-y-6 px-4 py-8 sm:px-6">
    <Notice />

    <form method="POST" action="/api/admin/guardar" class="space-y-6">
      <input type="hidden" name="accion" value="general" />
      <input type="hidden" name="volver" value={HERE} />

      <Card
        title="Cabecera"
        description="El nombre, la frase de entrada y el video de presentación."
      >
        <div class="grid gap-4 sm:grid-cols-2">
          <Field label="Nombre del proyecto" name="hero.brand" value={hero.brand} />
          <Field
            label="Número de WhatsApp"
            name="whatsapp.number"
            value={whatsapp.number}
            hint="Con código de país y sin espacios. Ej: 51987654321"
          />
          <Field
            label="Frase de entrada"
            name="hero.tagline"
            value={hero.tagline}
            type="textarea"
            rows={2}
            wide
          />
        </div>

        <div class="mt-4">
          <VideoFields
            prefix="hero.video"
            source={hero.video}
            poster={hero.poster}
            posterName="hero.poster"
          />
        </div>
      </Card>

      <Card
        title="Barra de urgencia"
        description="La franja negra de arriba del todo. Admite <strong> para resaltar palabras."
      >
        <label class="mb-4 flex items-center gap-2.5 text-sm text-sv-cream/80">
          <input
            type="checkbox"
            name="announcement.enabled"
            checked={announcement.enabled}
            class="h-4 w-4 accent-sv-lime"
          />
          Mostrar la barra
        </label>
        <Field label="Texto" name="announcement.html" value={announcement.html} type="textarea" rows={2} />
      </Card>

      <Card
        title="Botones de la cabecera"
        description="Cada botón abre WhatsApp con su propio mensaje, para saber de qué botón vino cada contacto. Deja el texto vacío o marca eliminar para quitarlo."
      >
        <div class="space-y-4">
          {
            ctaRows.map(({ cta, i }) => (
              <div class={rowBox}>
                <div class="grid gap-4 sm:grid-cols-2">
                  <Field
                    label={cta ? `Botón ${i + 1}` : 'Añadir botón'}
                    name={`cta.${i}.label`}
                    value={cta?.label ?? ''}
                    placeholder="¡Agenda tu visita!"
                  />
                  <Select
                    label="Color"
                    name={`cta.${i}.style`}
                    value={cta?.style ?? 'whatsapp'}
                    options={ctaStyles}
                  />
                  <Field
                    label="Mensaje que se escribe solo"
                    name={`cta.${i}.message`}
                    value={cta?.message ?? ''}
                    type="textarea"
                    rows={2}
                    wide
                  />
                </div>
                <div class="mt-3 flex flex-wrap items-center gap-5">
                  <label class="flex items-center gap-2 text-xs text-sv-cream/55">
                    Orden
                    <input
                      type="number"
                      name={`cta.${i}.orden`}
                      value={String(i)}
                      class="w-16 rounded-lg bg-sv-cream/5 px-2 py-1 text-sm text-sv-cream ring-1 ring-sv-lime/20 outline-none focus:ring-2 focus:ring-sv-lime"
                    />
                  </label>
                  {cta && (
                    <label class={deleteLabel}>
                      <input type="checkbox" name={`cta.${i}.borrar`} class="h-4 w-4 accent-red-400" />
                      Eliminar
                    </label>
                  )}
                </div>
              </div>
            ))
          }
        </div>
      </Card>

      <Card
        title="Buscadores y enlaces compartidos"
        description="Lo que se ve en Google y en la tarjeta que aparece al pasar el enlace por WhatsApp."
      >
        <div class="grid gap-4 sm:grid-cols-2">
          <Field label="Título" name="seo.title" value={seo.title} wide />
          <Field
            label="Descripción"
            name="seo.description"
            value={seo.description}
            type="textarea"
            rows={2}
            wide
          />
          <Field
            label="Imagen para compartir"
            name="seo.ogImage"
            value={seo.ogImage}
            hint="1200x630 px. Debe ser JPG o PNG: WhatsApp no muestra SVG."
            wide
          />
        </div>
      </Card>

      <Card title="Pie de página">
        <Field label="Texto" name="footer.text" value={footer.text} />
        <div class="mt-4 space-y-4">
          {
            linkRows.map(({ link, i }) => (
              <div class={rowBox}>
                <div class="grid gap-4 sm:grid-cols-2">
                  <Field
                    label={link ? `Enlace ${i + 1}` : 'Añadir enlace'}
                    name={`link.${i}.label`}
                    value={link?.label ?? ''}
                    placeholder="Política de privacidad"
                  />
                  <Field
                    label="Destino"
                    name={`link.${i}.href`}
                    value={link?.href ?? ''}
                    placeholder="/privacidad"
                  />
                </div>
                {link && (
                  <label class={`mt-3 ${deleteLabel}`}>
                    <input type="checkbox" name={`link.${i}.borrar`} class="h-4 w-4 accent-red-400" />
                    Eliminar
                  </label>
                )}
              </div>
            ))
          }
        </div>
      </Card>

      <div class="flex justify-end">
        <button
          type="submit"
          class="rounded-full bg-sv-lime px-7 py-3 font-heading text-sm font-bold tracking-wide text-sv-jungle-deep uppercase transition hover:brightness-110"
        >
          Guardar cambios
        </button>
      </div>
    </form>

    <Card title="Imágenes" description="Sube aquí las fotos y luego pega su ruta donde la necesites.">
      <Uploader volver={HERE} />
    </Card>
  </div>
</AdminLayout>
