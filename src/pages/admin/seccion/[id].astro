---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import Nav from '../../../components/admin/Nav.astro';
import Notice from '../../../components/admin/Notice.astro';
import Card from '../../../components/admin/Card.astro';
import Field from '../../../components/admin/Field.astro';
import Select from '../../../components/admin/Select.astro';
import Uploader from '../../../components/admin/Uploader.astro';
import VideoFields from '../../../components/admin/VideoFields.astro';
import Icon from '../../../components/Icon.astro';
import { readContent } from '../../../lib/content-store';
import { icons } from '../../../lib/icons';

export const prerender = false;

const { id } = Astro.params;
const content = await readContent();
const block = content.blocks.find((candidate) => candidate.id === id);

if (!block) {
  return Astro.redirect('/admin?e=no-existe', 302);
}

const HERE = `/admin/seccion/${block.id}`;

const iconOptions = Object.keys(icons).map((name) => ({ value: name, label: name }));
const ctaStyles = [
  { value: 'whatsapp', label: 'Verde WhatsApp' },
  { value: 'lime', label: 'Verde lima' },
  { value: 'gold', label: 'Dorado' },
  { value: 'outline', label: 'Solo contorno' },
];

const typeLabels = {
  video: 'Video',
  carousel: 'Carrusel de imágenes',
  showcase: 'Video + carrusel',
  text: 'Texto con puntos',
  marquee: 'Franja en movimiento',
} as const;

// Cada lista se pinta con una fila vacía al final para poder añadir un elemento.
const withBlank = <T,>(items: T[]) => [
  ...items.map((item, i) => ({ item, i })),
  { item: null, i: items.length },
];

const rowBox = 'rounded-xl bg-sv-jungle-deep/60 p-4 ring-1 ring-sv-lime/10';
const deleteLabel = 'flex items-center gap-2 text-xs font-semibold text-red-300';
const orderInput =
  'w-16 rounded-lg bg-sv-cream/5 px-2 py-1 text-sm text-sv-cream ring-1 ring-sv-lime/20 outline-none focus:ring-2 focus:ring-sv-lime';
---

<AdminLayout title="Editar sección">
  <Nav admin={Astro.locals.admin} />

  <div class="mx-auto max-w-4xl space-y-6 px-4 py-8 sm:px-6">
    <Notice />

    <div class="flex flex-wrap items-center justify-between gap-3">
      <div>
        <a href="/admin" class="text-xs text-sv-cream/50 underline-offset-4 hover:text-sv-lime hover:underline">
          ← Volver a las secciones
        </a>
        <h1 class="mt-1 font-heading text-xl text-sv-cream">
          {typeLabels[block.type]}{' '}
          <span class="text-sv-cream/35">#{block.id}</span>
        </h1>
      </div>
    </div>

    <form method="POST" action="/api/admin/guardar" class="space-y-6">
      <input type="hidden" name="accion" value="bloque" />
      <input type="hidden" name="id" value={block.id} />
      <input type="hidden" name="volver" value={HERE} />

      <Card title="Visibilidad">
        <label class="flex items-center gap-2.5 text-sm text-sv-cream/80">
          <input type="checkbox" name="enabled" checked={block.enabled} class="h-4 w-4 accent-sv-lime" />
          Mostrar esta sección en la página
        </label>
      </Card>

      {
        block.type === 'marquee' ? (
          <>
            <Card title="Nombre interno" description="Solo se ve aquí, para reconocer la franja.">
              <Field label="Nombre" name="label" value={block.label} />
            </Card>

            <Card
              title="Frases"
              description="Se desplazan en bucle. Deja el texto vacío o marca eliminar para quitar una."
            >
              <div class="space-y-4">
                {withBlank(block.items).map(({ item, i }) => (
                  <div class={rowBox}>
                    <div class="grid gap-4 sm:grid-cols-2">
                      <Select
                        label="Ícono"
                        name={`item.${i}.icon`}
                        value={item?.icon ?? 'escudo'}
                        options={iconOptions}
                      />
                      <Field
                        label={item ? `Frase ${i + 1}` : 'Añadir frase'}
                        name={`item.${i}.text`}
                        value={item?.text ?? ''}
                        placeholder="Documentación 100% en regla"
                      />
                    </div>
                    <div class="mt-3 flex flex-wrap items-center gap-5">
                      <label class="flex items-center gap-2 text-xs text-sv-cream/55">
                        Orden
                        <input type="number" name={`item.${i}.orden`} value={String(i)} class={orderInput} />
                      </label>
                      {item && (
                        <label class={deleteLabel}>
                          <input type="checkbox" name={`item.${i}.borrar`} class="h-4 w-4 accent-red-400" />
                          Eliminar
                        </label>
                      )}
                    </div>
                  </div>
                ))}
              </div>
            </Card>
          </>
        ) : (
          <>
            <Card title="Textos">
              <div class="grid gap-4 sm:grid-cols-2">
                <Field
                  label="Antetítulo"
                  name="eyebrow"
                  value={block.eyebrow ?? ''}
                  placeholder="El proyecto"
                  hint="El texto pequeño dorado sobre el título."
                />
                <Field label="Título" name="title" value={block.title} />
                <Field
                  label="Descripción"
                  name="description"
                  value={block.description ?? ''}
                  type="textarea"
                  wide
                />
              </div>
            </Card>

            {(block.type === 'video' || block.type === 'showcase') && (
              <Card title="Video">
                <VideoFields prefix="video" source={block.source} poster={block.poster} posterName="poster" />
              </Card>
            )}

            {block.type === 'showcase' && (
              <Card
                title="Encabezado del carrusel"
                description="El título que separa el video de las fotos. Déjalo vacío para no mostrarlo."
              >
                <Field label="Encabezado" name="heading" value={block.heading ?? ''} placeholder="Así se ve el proyecto" />
              </Card>
            )}

            {(block.type === 'carousel' || block.type === 'showcase') && (
              <Card
                title="Imágenes"
                description="Se deslizan de lado. Deja la ruta vacía o marca eliminar para quitar una."
              >
                <div class="space-y-4">
                  {withBlank(block.images).map(({ item, i }) => (
                    <div class={rowBox}>
                      <div class="flex flex-wrap gap-4">
                        {item?.src && (
                          <img
                            src={item.src}
                            alt=""
                            class="h-20 w-28 shrink-0 rounded-lg object-cover ring-1 ring-sv-lime/20"
                          />
                        )}
                        <div class="grid min-w-0 flex-1 gap-4 sm:grid-cols-2">
                          <Field
                            label={item ? `Imagen ${i + 1}` : 'Añadir imagen'}
                            name={`img.${i}.src`}
                            value={item?.src ?? ''}
                            placeholder="/uploads/foto.jpg"
                          />
                          <Field
                            label="Texto alternativo"
                            name={`img.${i}.alt`}
                            value={item?.alt ?? ''}
                            placeholder="Vista aérea del terreno"
                            hint="Lo que se lee si la foto no carga."
                          />
                          <Field
                            label="Pie de foto"
                            name={`img.${i}.caption`}
                            value={item?.caption ?? ''}
                            wide
                          />
                        </div>
                      </div>
                      <div class="mt-3 flex flex-wrap items-center gap-5">
                        <label class="flex items-center gap-2 text-xs text-sv-cream/55">
                          Orden
                          <input type="number" name={`img.${i}.orden`} value={String(i)} class={orderInput} />
                        </label>
                        {item && (
                          <label class={deleteLabel}>
                            <input type="checkbox" name={`img.${i}.borrar`} class="h-4 w-4 accent-red-400" />
                            Eliminar
                          </label>
                        )}
                      </div>
                    </div>
                  ))}
                </div>
              </Card>
            )}

            {block.type === 'text' && (
              <Card
                title="Puntos"
                description="Cada punto es una tarjeta con ícono. Deja el título vacío o marca eliminar para quitarlo."
              >
                <div class="space-y-4">
                  {withBlank(block.bullets).map(({ item, i }) => (
                    <div class={rowBox}>
                      <div class="flex flex-wrap gap-4">
                        <span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-sv-lime/10 text-sv-lime ring-1 ring-sv-lime/25">
                          <Icon name={item?.icon ?? 'escudo'} class="h-6 w-6" />
                        </span>
                        <div class="grid min-w-0 flex-1 gap-4 sm:grid-cols-2">
                          <Select
                            label="Ícono"
                            name={`bullet.${i}.icon`}
                            value={item?.icon ?? 'escudo'}
                            options={iconOptions}
                          />
                          <Field
                            label={item ? `Punto ${i + 1}` : 'Añadir punto'}
                            name={`bullet.${i}.title`}
                            value={item?.title ?? ''}
                            placeholder="Escritura pública"
                          />
                          <Field
                            label="Texto"
                            name={`bullet.${i}.text`}
                            value={item?.text ?? ''}
                            type="textarea"
                            rows={2}
                            wide
                          />
                        </div>
                      </div>
                      <div class="mt-3 flex flex-wrap items-center gap-5">
                        <label class="flex items-center gap-2 text-xs text-sv-cream/55">
                          Orden
                          <input type="number" name={`bullet.${i}.orden`} value={String(i)} class={orderInput} />
                        </label>
                        {item && (
                          <label class={deleteLabel}>
                            <input type="checkbox" name={`bullet.${i}.borrar`} class="h-4 w-4 accent-red-400" />
                            Eliminar
                          </label>
                        )}
                      </div>
                    </div>
                  ))}
                </div>
              </Card>
            )}

            <Card title="Botón de WhatsApp" description="El botón que cierra la sección.">
              <label class="mb-4 flex items-center gap-2.5 text-sm text-sv-cream/80">
                <input
                  type="checkbox"
                  name="cta.enabled"
                  checked={Boolean(block.cta)}
                  class="h-4 w-4 accent-sv-lime"
                />
                Mostrar el botón
              </label>
              <div class="grid gap-4 sm:grid-cols-2">
                <Field label="Texto del botón" name="cta.label" value={block.cta?.label ?? ''} />
                <Select
                  label="Color"
                  name="cta.style"
                  value={block.cta?.style ?? 'whatsapp'}
                  options={ctaStyles}
                />
                <Field
                  label="Mensaje que se escribe solo"
                  name="cta.message"
                  value={block.cta?.message ?? ''}
                  type="textarea"
                  rows={2}
                  wide
                />
              </div>
            </Card>
          </>
        )
      }

      <div class="flex justify-end">
        <button
          type="submit"
          class="rounded-full bg-sv-lime px-7 py-3 font-heading text-sm font-bold tracking-wide text-sv-jungle-deep uppercase transition hover:brightness-110"
        >
          Guardar cambios
        </button>
      </div>
    </form>

    {
      (block.type === 'carousel' || block.type === 'video' || block.type === 'showcase') && (
        <Card title="Imágenes" description="Sube una foto y pega la ruta que te devuelve en el campo de arriba.">
          <Uploader volver={HERE} />
        </Card>
      )
    }

    <Card title="Eliminar sección">
      <details>
        <summary
          class="w-fit cursor-pointer list-none rounded-full border border-red-500/40 px-4 py-2 text-sm font-semibold text-red-300 transition hover:bg-red-500/10"
        >
          Eliminar esta sección
        </summary>
        <div class="mt-4 rounded-xl bg-red-500/5 p-4 ring-1 ring-red-500/20">
          <p class="text-sm text-sv-cream/75">
            Se borra con todo su contenido y no se puede deshacer. Si solo quieres que
            deje de verse, desmarca la casilla de visibilidad y guarda.
          </p>
          <form method="POST" action="/api/admin/guardar" class="mt-4">
            <input type="hidden" name="accion" value="eliminar" />
            <input type="hidden" name="id" value={block.id} />
            <input type="hidden" name="volver" value={HERE} />
            <button
              type="submit"
              class="rounded-full bg-red-500/80 px-4 py-2 text-sm font-bold text-white transition hover:bg-red-500"
            >
              Sí, eliminar
            </button>
          </form>
        </div>
      </details>
    </Card>
  </div>
</AdminLayout>
