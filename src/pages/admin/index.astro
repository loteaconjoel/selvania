---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Nav from '../../components/admin/Nav.astro';
import Notice from '../../components/admin/Notice.astro';
import Card from '../../components/admin/Card.astro';
import { readContent } from '../../lib/content-store';
import type { Block } from '../../data/types';

export const prerender = false;

const content = await readContent();
const blocks = content.blocks;

const typeLabels: Record<Block['type'], string> = {
  video: 'Video',
  carousel: 'Carrusel de fotos',
  showcase: 'Video + carrusel',
  text: 'Texto con puntos',
  marquee: 'Franja en movimiento',
};

const blockName = (block: Block) => (block.type === 'marquee' ? block.label : block.title);

/** Qué contiene la sección, en una línea. Evita tener que entrar para saberlo. */
function contenido(block: Block): string[] {
  const partes: string[] = [];

  if (block.type === 'marquee') {
    partes.push(`${block.items.length} frases`);
    return partes;
  }

  if (block.type === 'showcase' && block.openingImages.length > 0) {
    partes.push(
      block.openingImages.length === 1
        ? '1 foto de apertura'
        : `${block.openingImages.length} fotos de apertura`,
    );
  }

  if (block.type === 'video' || block.type === 'showcase') {
    partes.push(
      block.source.kind === 'youtube'
        ? block.source.youtubeId
          ? 'video de YouTube'
          : 'video sin poner'
        : 'video propio',
    );
  }

  if (block.type === 'carousel' || block.type === 'showcase') {
    partes.push(block.images.length === 1 ? '1 foto' : `${block.images.length} fotos`);
  }

  if (block.type === 'text') {
    partes.push(`${block.bullets.length} puntos`);
  }

  partes.push(block.cta ? `botón «${block.cta.label}»` : 'sin botón');

  return partes;
}

const fondoLabel = (block: Block) => {
  const modo = block.surface ?? 'auto';
  return modo === 'dark' ? 'Verde profundo' : modo === 'light' ? 'Verde medio' : 'Fondo automático';
};

const iconButton =
  'grid h-9 w-9 place-items-center rounded-lg bg-sv-jungle text-sv-lime transition hover:bg-sv-lime hover:text-sv-jungle-deep disabled:cursor-not-allowed disabled:opacity-25 disabled:hover:bg-sv-jungle disabled:hover:text-sv-lime';
---

<AdminLayout title="Secciones">
  <Nav admin={Astro.locals.admin} />

  <div class="mx-auto max-w-4xl space-y-6 px-4 py-8 sm:px-6">
    <Notice />

    <header>
      <h1 class="font-heading text-2xl text-sv-cream">Secciones de la página</h1>
      <p class="mt-1.5 max-w-2xl text-sm text-sv-cream/60">
        Aparecen en la web en este mismo orden. Pulsa <strong>Editar</strong> para cambiar
        sus textos, fotos y colores, o <strong>Ver</strong> para ir directo a esa parte de
        la web.
      </p>
      <p class="mt-3 text-sm text-sv-cream/50">
        El nombre del proyecto, el número de WhatsApp y el video de la cabecera están en{' '}
        <a href="/admin/general" class="text-sv-lime underline-offset-4 hover:underline">General</a>.
        {' '}Los colores y las letras de toda la página, en{' '}
        <a href="/admin/tema" class="text-sv-lime underline-offset-4 hover:underline">Tema</a>.
      </p>
    </header>

    <ol class="space-y-3">
      {
        blocks.map((block, i) => (
          <li
            class:list={[
              'rounded-2xl p-4 ring-1 transition sm:p-5',
              block.enabled
                ? 'bg-sv-cream/5 ring-sv-lime/15'
                : 'bg-sv-cream/[0.02] ring-sv-cream/10',
            ]}
          >
            <div class="flex items-start gap-3.5">
              <span
                class:list={[
                  'grid h-8 w-8 shrink-0 place-items-center rounded-lg font-heading text-sm font-bold',
                  block.enabled
                    ? 'bg-sv-lime text-sv-jungle-deep'
                    : 'bg-sv-cream/10 text-sv-cream/40',
                ]}
              >
                {i + 1}
              </span>

              <div class="min-w-0 flex-1">
                <a
                  href={`/admin/seccion/${block.id}`}
                  class:list={[
                    'font-heading text-base font-bold underline-offset-4 hover:underline',
                    block.enabled ? 'text-sv-cream hover:text-sv-lime' : 'text-sv-cream/50',
                  ]}
                >
                  {blockName(block)}
                </a>

                <p class="mt-1 text-xs text-sv-cream/45">
                  {typeLabels[block.type]} · {fondoLabel(block)}
                </p>

                <ul class="mt-2.5 flex flex-wrap gap-1.5">
                  {contenido(block).map((parte) => (
                    <li class="rounded-full bg-sv-jungle-deep/70 px-2.5 py-1 text-xs text-sv-cream/65">
                      {parte}
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <div class="mt-4 flex flex-wrap items-center gap-2">
              <form method="POST" action="/api/admin/guardar">
                <input type="hidden" name="accion" value="mover" />
                <input type="hidden" name="id" value={block.id} />
                <input type="hidden" name="direccion" value="arriba" />
                <input type="hidden" name="volver" value="/admin" />
                <button type="submit" class={iconButton} aria-label="Subir una posición" disabled={i === 0}>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="h-4 w-4">
                    <path d="m5 15 7-7 7 7" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </button>
              </form>

              <form method="POST" action="/api/admin/guardar">
                <input type="hidden" name="accion" value="mover" />
                <input type="hidden" name="id" value={block.id} />
                <input type="hidden" name="direccion" value="abajo" />
                <input type="hidden" name="volver" value="/admin" />
                <button
                  type="submit"
                  class={iconButton}
                  aria-label="Bajar una posición"
                  disabled={i === blocks.length - 1}
                >
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="h-4 w-4">
                    <path d="m5 9 7 7 7-7" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </button>
              </form>

              <span class="flex-1" />

              <form method="POST" action="/api/admin/guardar">
                <input type="hidden" name="accion" value="visibilidad" />
                <input type="hidden" name="id" value={block.id} />
                <input type="hidden" name="volver" value="/admin" />
                <button
                  type="submit"
                  class:list={[
                    'rounded-full px-3 py-1.5 text-xs font-semibold transition',
                    block.enabled
                      ? 'bg-sv-lime/15 text-sv-lime hover:bg-sv-lime/25'
                      : 'bg-sv-cream/10 text-sv-cream/50 hover:bg-sv-cream/20',
                  ]}
                >
                  {block.enabled ? 'Visible' : 'Oculta'}
                </button>
              </form>

              <a
                href={`/#${block.id}`}
                target="_blank"
                rel="noopener"
                class="rounded-full px-3 py-1.5 text-xs font-semibold text-sv-cream/60 transition hover:bg-sv-cream/10 hover:text-sv-cream"
              >
                Ver
              </a>

              <a
                href={`/admin/seccion/${block.id}`}
                class="rounded-full border border-sv-lime/35 px-4 py-1.5 text-xs font-semibold text-sv-lime transition hover:bg-sv-lime hover:text-sv-jungle-deep"
              >
                Editar
              </a>
            </div>
          </li>
        ))
      }
    </ol>

    <Card
      title="Añadir una sección"
      description="Se crea oculta, para que puedas prepararla con calma antes de que se vea."
    >
      <form method="POST" action="/api/admin/guardar" class="flex flex-wrap items-end gap-3">
        <input type="hidden" name="accion" value="nuevo" />
        <input type="hidden" name="volver" value="/admin" />
        <label class="min-w-0 flex-1">
          <span class="text-xs font-semibold tracking-wide text-sv-cream/70 uppercase">
            Tipo de sección
          </span>
          <select
            name="tipo"
            class="mt-1.5 w-full rounded-xl bg-sv-cream/5 px-3.5 py-2.5 text-sm text-sv-cream ring-1 ring-sv-lime/20 outline-none focus:ring-2 focus:ring-sv-lime"
          >
            <option value="carousel">Carrusel de fotos</option>
            <option value="showcase">Video + carrusel</option>
            <option value="video">Solo video</option>
            <option value="text">Texto con puntos</option>
            <option value="marquee">Franja en movimiento</option>
          </select>
        </label>
        <button
          type="submit"
          class="rounded-full bg-sv-lime px-5 py-2.5 text-sm font-bold text-sv-jungle-deep uppercase transition hover:brightness-110"
        >
          Crear
        </button>
      </form>
    </Card>

    <details class="rounded-2xl bg-sv-cream/5 p-5 ring-1 ring-sv-lime/15 sm:p-6">
      <summary class="cursor-pointer list-none text-sm font-semibold text-red-300">
        Restablecer todo el contenido
      </summary>
      <div class="mt-4 rounded-xl bg-red-500/5 p-4 ring-1 ring-red-500/20">
        <p class="text-sm text-sv-cream/75">
          Descarta <strong>todos</strong> los textos, fotos, colores y secciones que se
          hayan guardado, y vuelve al contenido con el que se entregó la página. No se
          puede deshacer.
        </p>
        <form method="POST" action="/api/admin/guardar" class="mt-4">
          <input type="hidden" name="accion" value="restablecer" />
          <input type="hidden" name="volver" value="/admin" />
          <button
            type="submit"
            class="rounded-full bg-red-500/80 px-4 py-2 text-sm font-bold text-white transition hover:bg-red-500"
          >
            Sí, restablecer
          </button>
        </form>
      </div>
    </details>
  </div>
</AdminLayout>
